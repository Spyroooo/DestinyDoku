{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "destinydoku-daily-counter",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-16",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "https://destinydoku.com,https://www.destinydoku.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "destinydoku-community",
			"database_id": "ed5bc104-d69f-4d95-954c-d4bd0a8d02b8",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "WRITE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	]
}
